PORT=4000
DATABASE_URL=postgres://sweety:sweety@localhost:5432/sweety
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Timezone used to decide what "today" is (for the "no future dates" rule)
APP_TIMEZONE=Asia/Kolkata
# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:5173

# --- Daily reminder job (BullMQ). Optional: off by default, needs Redis. ---
REMINDERS_ENABLED=false
REDIS_URL=redis://localhost:6379
# Runs every day at 20:00 in APP_TIMEZONE
REMINDER_CRON=0 20 * * *
QUEUE_PREFIX=sweety
